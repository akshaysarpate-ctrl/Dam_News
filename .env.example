# Copy this file to ".env" and fill in what you have. Everything is optional except that
# YouTube results need YOUTUBE_API_KEY and the AI check needs ANTHROPIC_API_KEY.

# YouTube Data API v3 key (console.cloud.google.com -> enable "YouTube Data API v3")
YOUTUBE_API_KEY=AIzaSyAO4eVOo80nkNX-N9nN0rA8FOWxcPnzU_g

# Claude API key (console.anthropic.com). Enables the second-pass relevance check that
# also fills in state, district and dam name for regional-language stories.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Set to 1 to keep failures of river flood embankments (levees), which local news often calls "dam"
INCLUDE_RIVER_EMBANKMENTS=0

# Searches run at the same time when you press "Search the internet" on the website (lower to 1 if Google refuses requests)
SEARCH_WORKERS=3
